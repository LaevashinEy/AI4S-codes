def tmm_reflectance(d_list, wavelengths, n_list, n_sub, n_air=1.0):
    """
    传输矩阵法计算多层膜反射光谱。

    参数：
        d_list: 各层膜厚，单位 nm，长度 = 层数
        wavelengths: 波长数组，单位 nm
        n_list: 各层折射率，长度 = 层数
        n_sub: 基底折射率
        n_air: 入射介质折射率，默认空气 n=1.0

    返回：
        R: 反射率数组，形状与 wavelengths 相同
    """
    d_list = np.asarray(d_list, dtype=float)
    n_list = np.asarray(n_list, dtype=float)
    wavelengths = np.asarray(wavelengths, dtype=float)

    R = np.zeros_like(wavelengths, dtype=float)

    for i, lam in enumerate(wavelengths):
        # 相位厚度 delta = 2*pi*n*d / lambda
        delta = 2 * np.pi * n_list * d_list / lam

        # 每一层的特征矩阵
        M_total = np.eye(2, dtype=complex)

        for n_j, delta_j in zip(n_list, delta):
            M_j = np.array([
                [np.cos(delta_j), 1j * np.sin(delta_j) / n_j],
                [1j * n_j * np.sin(delta_j), np.cos(delta_j)]
            ], dtype=complex)
            M_total = M_total @ M_j

        # 入射介质和基底导纳
        eta_0 = n_air
        eta_s = n_sub

        # 反射系数
        B = M_total[0, 0] + M_total[0, 1] * eta_s
        C = M_total[1, 0] + M_total[1, 1] * eta_s

        r = (eta_0 * B - C) / (eta_0 * B + C)
        R[i] = np.abs(r) ** 2

    return R
def generate_dataset(n_samples, layer_indices, n_sub, wavelengths,
                     d_min=40.0, d_max=180.0):
    """
    生成膜厚-反射光谱数据集。

    返回：
        X: 膜厚，形状 (n_samples, 4)
        Y: 反射光谱，形状 (n_samples, 41)
    """
    n_layers = len(layer_indices)

    X = np.random.uniform(d_min, d_max, size=(n_samples, n_layers))
    Y = np.zeros((n_samples, len(wavelengths)), dtype=float)

    for i in range(n_samples):
        Y[i] = tmm_reflectance(
            d_list=X[i],
            wavelengths=wavelengths,
            n_list=layer_indices,
            n_sub=n_sub
        )

    return X, Y


